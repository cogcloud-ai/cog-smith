{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "{{TITLE}} output",
  "description": "The payload carried under envelope v1's `payload` key. Normative; the model is shown a worked example instead (small models copy examples reliably).",
  "type": "object",
  "required": ["abstained", "entries"],
  "properties": {
    "abstained": { "type": "boolean" },
    "abstain_reason": { "type": ["string", "null"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "detail", "item_ids", "evidence_quote"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 },
          "item_ids": { "type": "array", "minItems": 1,
                        "items": { "type": "string" } },
          "evidence_quote": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
