"""Deterministic suite for {{COG_NAME}} (created by cog-smith, kind: code).

Covers: manifest consistency, schema agreement, envelope mechanics, the
grant checks, and the journal. Extend it as task_logic.py grows — a code Cog
has no model-backed path, so this suite is the whole net.
"""
import json
import sys
import tempfile
import unittest
from datetime import datetime, timedelta, timezone
from unittest import mock
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

import cog_core     # noqa: E402
import task_logic   # noqa: E402


def sample_bundle():
    return json.loads((ROOT / "examples" / "sample-bundle.json").read_text())


def grant(**overrides):
    """A well-formed grant for THIS Cog, valid for an hour."""
    doc = {
        "schema": cog_core.GRANT_SCHEMA,
        "grant_id": "run-1/step/0",
        "run_id": "run-1",
        "recipient": {"step": "step", "cog": dict(cog_core.SELF_ID)},
        "issued_at": cog_core.utc_now(),
        "issued_by": {"kind": "admission"},
        "operations": [{"resource": "github", "action": "read",
                        "repositories": ["example-org/example-repo"]}],
        "valid": {"expires_at": (datetime.now(timezone.utc)
                                 + timedelta(hours=1)).isoformat(),
                  "run_id": "run-1"},
    }
    doc.update(overrides)
    return doc


class TestManifestConsistency(unittest.TestCase):
    def test_identity_fields(self):
        for field in ("schema", "id", "version", "kind", "summary", "owner",
                      "license", "io", "interfaces"):
            self.assertIn(field, cog_core.MANIFEST)
        self.assertEqual(cog_core.MANIFEST["kind"], "code")

    def test_a_code_cog_declares_no_model_requirement(self):
        self.assertEqual(cog_core.MANIFEST.get("requires") or [], [])

    def test_declared_shapes_exist(self):
        self.assertIsNotNone(cog_core.INPUT_SCHEMA)
        self.assertIsNotNone(cog_core.OUTPUT_SCHEMA)

    def test_interface_tasks_exist_in_pixi(self):
        pixi = (ROOT / "pixi.toml").read_text()
        for interface in cog_core.MANIFEST.get("interfaces") or []:
            self.assertIn(f"\n{interface['task']} = ", "\n" + pixi)

    def test_exactly_one_default_interface(self):
        defaults = [i for i in cog_core.MANIFEST["interfaces"]
                    if i.get("default")]
        self.assertEqual(len(defaults), 1)


class TestInvoke(unittest.TestCase):
    def test_sample_bundle_produces_a_valid_payload(self):
        env = cog_core.invoke(sample_bundle())
        self.assertTrue(env["ok"], env)
        self.assertEqual(env["problems"], [])
        self.assertEqual(env["payload"]["item_count"],
                         len(sample_bundle()["items"]))

    def test_a_full_run_carries_no_schema_problem(self):
        """The contract, not `ok`: a Cog whose tests assert only `ok` can emit
        a payload its own output schema refuses — the first live triage sweep
        found exactly that on first contact with real data.

        `ok` and the payload are asserted in the SAME test as the schema
        claim: a `task-failed` envelope carries no schema problem either, so
        the schema assertion alone passes vacuously on an early failure
        ."""
        env = cog_core.invoke(sample_bundle())
        self.assertTrue(env["ok"], env)
        self.assertIsInstance(env.get("payload"), dict)
        self.assertEqual([p for p in env["problems"] if p["check"] == "schema"],
                         [], env["problems"])

    def test_binding_names_the_code_and_carries_no_model(self):
        env = cog_core.invoke(sample_bundle())
        self.assertEqual(env["binding"]["kind"], "code")
        self.assertNotIn("model", env["binding"])
        self.assertEqual(env["binding"]["task_logic_sha256"],
                         cog_core.task_logic_sha256())

    def test_invalid_input_is_reported(self):
        env = cog_core.invoke({"items": []})
        self.assertFalse(env["ok"])
        self.assertEqual(env["error"]["code"], "invalid-input")

    def test_duplicate_ids_are_an_input_contract_check(self):
        problems = task_logic.check_input(
            {"items": [{"id": "a", "text": "x"}, {"id": "a", "text": "y"}]})
        self.assertTrue(problems)


class TestGrantChecks(unittest.TestCase):
    def test_a_well_formed_grant_passes(self):
        self.assertEqual(cog_core.check_grant(grant(), run_id="run-1"),
                         (None, None))

    def test_an_expired_grant_is_refused(self):
        stale = grant(valid={"expires_at": (datetime.now(timezone.utc)
                                            - timedelta(minutes=1)).isoformat(),
                             "run_id": "run-1"})
        code, _ = cog_core.check_grant(stale, run_id="run-1")
        self.assertEqual(code, "grant-expired")

    def test_a_grant_for_another_run_is_refused(self):
        code, _ = cog_core.check_grant(grant(), run_id="run-2")
        self.assertEqual(code, "grant-wrong-run")

    def test_a_grant_for_another_cog_is_refused(self):
        other = grant(recipient={"step": "s",
                                 "cog": {"id": "openteams/cog-somebody-else"}})
        code, _ = cog_core.check_grant(other, run_id="run-1")
        self.assertEqual(code, "grant-wrong-recipient")

    def test_reads_and_writes_are_checked_against_the_grant(self):
        ok, _ = cog_core.read_allowed(grant(), "example-org/example-repo")
        self.assertTrue(ok)
        ok, detail = cog_core.read_allowed(grant(), "someone/else")
        self.assertFalse(ok)
        self.assertIn("not in this grant", detail)


class TestJournal(unittest.TestCase):
    def test_entries_round_trip_and_phases_are_the_last_word(self):
        with tempfile.TemporaryDirectory() as tmp:
            journal = cog_core.Journal(Path(tmp) / "journal.jsonl")
            journal.append({"change_id": "c1", "phase": "applying"})
            journal.append({"change_id": "c1", "phase": "applied"})
            journal.append({"change_id": "c2", "phase": "applying"})
            self.assertEqual(len(journal.read()), 3)
            self.assertEqual(journal.phases(),
                             {"c1": "applied", "c2": "applying"})

    def test_a_torn_last_line_is_dropped_not_raised(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "journal.jsonl"
            journal = cog_core.Journal(path)
            journal.append({"change_id": "c1", "phase": "applied"})
            with open(path, "a") as handle:
                handle.write('{"change_id": "c2", "ph')
            self.assertEqual(journal.phases(), {"c1": "applied"})


class TestInputSeverity(unittest.TestCase):
    def invoke_sample(self):
        return cog_core.invoke(sample_bundle())

    def test_warning_only_input_proceeds_and_keeps_input_and_output_findings(self):
        warning = cog_core.problem("input-thin", "optional evidence is thin", "warning")
        output = cog_core.problem("output-note", "review the result", "warning")
        with mock.patch.object(task_logic, "check_input", return_value=[warning]), \
             mock.patch.object(task_logic, "check_output", return_value=[output]):
            env = self.invoke_sample()
        self.assertTrue(env["ok"], env)
        self.assertIsNotNone(env["payload"])
        self.assertEqual(env["problems"], [warning, output])

    def test_input_errors_refuse_even_alongside_warnings(self):
        error = cog_core.problem("input-bad", "required evidence is missing")
        warning = cog_core.problem("input-thin", "optional evidence is thin", "warning")
        for problems in ([error], [warning, error], [warning] * 5 + [error]):
            with self.subTest(problems=problems), \
                 mock.patch.object(task_logic, "check_input", return_value=problems):
                with mock.patch.object(task_logic, "run") as work:
                    env = cog_core.invoke(sample_bundle())
                work.assert_not_called()
                self.assertFalse(env["ok"])
                self.assertEqual(env["error"]["code"], "invalid-input")
                self.assertEqual(env["error"]["detail"], error["detail"])
                self.assertEqual(env["problems"], problems)

    def test_warn_input_proceeds(self):
        warning = cog_core.problem("input-thin", "optional evidence is thin", "warn")
        with mock.patch.object(task_logic, "check_input", return_value=[warning]):
            env = self.invoke_sample()
        self.assertTrue(env["ok"], env)
        self.assertIn(warning, env["problems"])

    def test_unrecognised_input_severity_refuses(self):
        for severity in ("Error", "ERROR", "fatal", None, "missing"):
            rejected = cog_core.problem("input-bad", "unusable input", severity)
            if severity == "missing":
                del rejected["severity"]
            with self.subTest(severity=severity), \
                 mock.patch.object(task_logic, "check_input", return_value=[rejected]):
                with mock.patch.object(task_logic, "run") as work:
                    env = cog_core.invoke(sample_bundle())
                work.assert_not_called()
                self.assertFalse(env["ok"])
                self.assertEqual(env["error"]["code"], "invalid-input")
                self.assertEqual(env["problems"], [rejected])

    def test_input_warning_is_preserved_when_later_work_fails(self):
        warning = cog_core.problem("input-thin", "optional evidence is thin", "warning")
        with mock.patch.object(task_logic, "check_input", return_value=[warning]):
            with mock.patch.object(task_logic, "run", side_effect=RuntimeError("failed")):
                env = cog_core.invoke(sample_bundle())
        self.assertFalse(env["ok"])
        self.assertIn(warning, env["problems"])


if __name__ == "__main__":
    unittest.main()
